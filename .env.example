# Copier ce fichier en .env puis adapter les valeurs.

# --- Application ---
SECRET_KEY=remplace-moi-par-une-longue-chaine-aleatoire
TOKEN_HOURS=24
# Charge des donnees de demonstration au premier demarrage (true/false)
SEED_DEMO=true

# --- Base operationnelle ---
# Par defaut : SQLite local (aucune installation). En production : PostgreSQL/PostGIS
# DATABASE_URL=postgresql+psycopg://ecoabidjan:motdepasse@localhost:5432/ecoabidjan

# --- IA d'analyse des photos ---
# local     : estimation heuristique hors ligne (mode demo)
# snowflake : Snowflake Cortex AI (AI_COMPLETE multimodal), repli automatique sur local en cas d'erreur
AI_PROVIDER=local
CORTEX_VISION_MODEL=claude-3-5-sonnet
CORTEX_IMAGE_STAGE=@ECOABIDJAN.RAW.PHOTOS_STAGE

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
# Ou authentification par cle : SNOWFLAKE_PRIVATE_KEY_FILE=chemin/vers/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_ROLE=ECOABIDJAN_APP
SNOWFLAKE_WAREHOUSE=ECOABIDJAN_WH
SNOWFLAKE_DATABASE=ECOABIDJAN
SNOWFLAKE_SCHEMA=CORE
